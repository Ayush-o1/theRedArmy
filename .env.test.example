# Copy to .env.test for `npm test` and `npm run test:e2e`.
# The tests TRUNCATE every table: never point this at a database you care about.
NODE_ENV=test
# A separate database. With the Docker Postgres service, create it once:
#   docker compose exec postgres createdb -U theredarmy theredarmy_test
DATABASE_URL=postgresql://theredarmy:theredarmy@localhost:5433/theredarmy_test?schema=public
# A separate Redis database number from development (/0); the tests flush it.
REDIS_URL=redis://localhost:6379/1
# Any valid key; generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# The provider tests start a mock server on 127.0.0.1, which the SSRF guard
# would otherwise refuse.
ALLOW_PRIVATE_PROVIDER_URLS=true
LOG_LEVEL=silent
