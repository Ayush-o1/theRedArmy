{
  "name": "promptgate",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted regression testing for LLM prompts: run prompt versions against test suites in background workers and see exactly which cases regressed.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:unit": "node --env-file-if-exists=.env.test --test \"test/unit/**/*.test.js\"",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db": "node --env-file-if-exists=.env.test node_modules/prisma/build/index.js migrate deploy",
    "pretest": "npm run test:db --silent",
    "postinstall": "prisma generate"
  },
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
