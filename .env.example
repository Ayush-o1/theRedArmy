# Copy to .env and adjust. Never commit the real .env.
# Every variable is described in docs/configuration.md.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://theredarmy:theredarmy@localhost:5433/theredarmy?schema=public
REDIS_URL=redis://localhost:6379/0
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Used to encrypt provider API keys at rest. Changing it makes stored keys unreadable.
ENCRYPTION_KEY=
# Allow provider base URLs on localhost/private networks (e.g. a local Ollama).
# Keep false on any shared deployment (SSRF protection).
ALLOW_PRIVATE_PROVIDER_URLS=false
LOG_LEVEL=info
SESSION_TTL_HOURS=168
WORKER_CONCURRENCY=4
# The provider timeout must end more than 5 s before the job lease does.
JOB_LEASE_SECONDS=60
PROVIDER_TIMEOUT_MS=30000
